# Base URL of the FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# "true" starts the UI in demo mode (curated mock data, no backend calls).
# The Settings page toggle overrides this at runtime.
NEXT_PUBLIC_DEMO_MODE=false

# Client-side timeout for Knowledge Center evidence search, in milliseconds.
NEXT_PUBLIC_EVIDENCE_SEARCH_TIMEOUT_MS=15000
