OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_RETRIES=5
EMBEDDING_INITIAL_BACKOFF_SECONDS=1.0
EMBEDDING_MAX_BACKOFF_SECONDS=20.0
EMBEDDING_THROTTLE_SECONDS=0.25
EVIDENCE_SEARCH_TIMEOUT_SECONDS=8.0
EVIDENCE_QUERY_EMBEDDING_MAX_RETRIES=1
EVIDENCE_DB_STATEMENT_TIMEOUT_MS=1500
EVIDENCE_VECTOR_CANDIDATE_LIMIT=8
POSTGRES_URL=postgresql+psycopg2://redisense:redisense@localhost:5432/redisense
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ISSUER=
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEMO_MODE_ENABLED=true
MAX_UPLOAD_SIZE_MB=10
